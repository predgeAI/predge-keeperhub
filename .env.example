# Predge signal service (the "verified input" side)
PREDGE_SIGNAL_URL=http://localhost:4055/v1/signal
PORT=4055
# ed25519 signer for the Predge signal. Generate one with: npm run signal -- --new-key
PREDGE_SIGNER_PRIVATE_KEY=
# The public key an integrator pins to trust Predge signals (hex).
PREDGE_SIGNER_KEY_ID=

# KeeperHub (the "deterministic execution" side)
# Create at app.keeperhub.com -> Settings -> Developer -> API keys (kh_ prefix).
KEEPERHUB_API_KEY=
KEEPERHUB_BASE_URL=https://app.keeperhub.com
# Sepolia testnet chain id. Value moves here for the demo (free faucet gas).
NETWORK=11155111
# The address value is moved TO when a verified signal clears the threshold.
EXECUTION_TARGET_ADDRESS=
# Minimum conviction (0-100) the signed signal must carry before KeeperHub executes.
CONVICTION_THRESHOLD=70
